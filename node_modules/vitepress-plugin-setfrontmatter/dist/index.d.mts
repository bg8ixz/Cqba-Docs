import { Plugin } from 'vite';
import { GlobOptions } from 'tinyglobby';

interface AutoFrontmatterOption {
    /**
     * 扫描的文件路径表达式，为 global 表达式
     */
    pattern?: string | string[];
    /**
     * tinyglobby 的配置项
     * 插件默认已经忽略 node_modules 和 dist 目录的所有文件
     */
    globOptions?: GlobOptions;
    /**
     * permalink 前缀，例如设置为 "/pages/"，则生成的 permalink 为 "/pages/xxxx"
     */
    permalinkPrefix?: string;
    /**
      * 是否启用自动添加 frontmatter.categories 功能，默认为 true
    */
    categories?: boolean;
    /**
     * 要从 frontmatter 中删除的键名
     * 下面的coverImg为false并且key存在，则删除该 key，默认为 "coverImg"
     */
    key?: string;
    /**
     * 是否启用自动添加 frontmatter.coverImg 功能，默认为 false
     */
    coverImg?: boolean | undefined;
    /**
     * 转换处理好的 frontmatter，该函数需要返回一个新的 frontmatter 或只返回 undefined，如果返回 {}，则清空 MD 文件本身存在的 frontmatter
     */
    transform?: (frontmatter: Record<string, any>, fileInfo: FileInfo) => Record<string, any> | void;
}
interface FileInfo {
    /**
     * 文件绝对路径
     */
    filePath: string;
    /**
     * 文件相对路径
     */
    relativePath: string;
}

declare function VitePluginVitePressAutoFrontmatter(option?: AutoFrontmatterOption): Plugin;
/**
 * 获取实际的文件名
 *
 * @param filename 文件名
 */
declare const getMdFileTitle: (filename: string) => string;
/**
 * 获取文件信息
 *
 * @param srcDir vitepress 配置项的 srcDir
 * @param filePath  文件路径
 */
declare const getFileInfo: (srcDir: string, filePath: string) => {
    filePath: string;
    relativePath: string;
};
/**
 * 创建 permalink 永久链接
 */
declare const createPermalink: (permalinkPrefix: string | undefined) => string | undefined;
/**
 * 创建 categories 分类列表
 *
 * @param fileInfo 文件信息
 * @param ignore 需要忽略的文件名或目录名
 */
declare const createCategory: (flag: boolean | undefined, fileInfo: FileInfo, ignore?: string | string[]) => {
    categories: string[];
} | undefined;

export { VitePluginVitePressAutoFrontmatter, createCategory, createPermalink, VitePluginVitePressAutoFrontmatter as default, getFileInfo, getMdFileTitle };
export type { AutoFrontmatterOption, FileInfo };
